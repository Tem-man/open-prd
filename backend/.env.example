# 选择协议标准: openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# OpenAI 标准（适用于 OpenAI、OpenRouter、DeepSeek、SiliconFlow 等兼容服务）
# 切换厂商只需修改 OPENAI_BASE_URL 和 OPENAI_API_KEY，代码无需变动
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic 标准（适用于 Anthropic 及兼容服务）
# 切换厂商只需修改 ANTHROPIC_BASE_URL 和 ANTHROPIC_API_KEY，代码无需变动
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Ollama（本地离线推理，无需 API Key）
OLLAMA_BASE_URL=http://localhost:11434

PORT=3000

# 数据根目录（SQLite + prototypes/*.fig）。不设则默认 backend/data/
# Electron 打包后由主进程注入为 app.getPath('userData')
# DATA_DIR=

# 位图矢量化（P5）：不配则该功能不可用
# VECTORIZE_PROVIDER=recraft
# RECRAFT_API_KEY=
# FAL_API_KEY=

# ── 调试选项（开发时按需开启，生产环境保持注释）────────────────────────────────
# Agent 精简日志：[agent] messages →（type + content 前 80 字）
# LANGCHAIN_AGENT_VERBOSE=true
# LangChain 全量日志：[llm/start]、[llm/end] 及序列化 messages / generations
# LANGCHAIN_LLM_VERBOSE=true
