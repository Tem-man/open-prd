{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');const d='dist/services/prd/runtime';fs.rmSync(d,{recursive:true,force:true});fs.cpSync('src/services/prd/runtime',d,{recursive:true})\"",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json",
    "test": "tsx --test src/services/llmStream.test.ts src/services/agent/history.test.ts src/services/agent/orchestrator.test.ts src/services/sectionLocator.test.ts src/services/versionIntake.test.ts",
    "test:intent": "tsx src/services/agent/__tests__/intentEval.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/ollama": "^1.2.7",
    "@langchain/openai": "^1.4.6",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "langchain": "^1.5.12",
    "multer": "^2.1.1",
    "nanoid": "^5.1.11",
    "node-html-parser": "^7.1.0",
    "uuid": "^14.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
