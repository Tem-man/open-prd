{
  "name": "open-prd",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "lint": "pnpm --filter frontend lint && pnpm --filter backend lint",
    "typecheck": "pnpm --filter frontend typecheck && pnpm --filter backend typecheck",
    "start": "pnpm --filter daemon start",
    "stop": "pnpm --filter daemon stop",
    "restart": "pnpm --filter daemon restart",
    "dist:win": "node scripts/build-desktop.mjs --platform=win32",
    "dist:mac": "node scripts/build-desktop.mjs --platform=darwin",
    "dist:linux": "node scripts/build-desktop.mjs --platform=linux",
    "icon": "python scripts/generate-icon.py",
    "fix:native": "node scripts/fix-native-module.mjs"
  }
}
